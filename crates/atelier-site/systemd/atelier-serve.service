# A systemd user unit for `atelier serve`, the read-only site over every
# Atelier repository under ~/projects. Install and publish it as
# docs/architecture/site.md#running-it-as-a-service says.
[Unit]
Description=Atelier site (atelier serve)
After=network.target

[Service]
ExecStart=%h/.cargo/bin/atelier serve --bind 127.0.0.1:7341 --root %h/projects
Environment=ATELIER_NO_UPDATE_CHECK=1
Restart=on-failure
RestartSec=5
# Keep the host's other services (T3 Code) responsive: at most one core and
# 1 GiB, whatever the site is asked to build.
MemoryMax=1G
CPUQuota=100%
Nice=10

[Install]
WantedBy=default.target
