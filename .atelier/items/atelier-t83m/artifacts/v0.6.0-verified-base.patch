+/// A catch-up import has exactly one incoming parent, at the configured
+/// local base or its configured forge remote's tracking ref. Neither staged
+/// nor unstaged config can supply that authority. A config change must be
+/// committed separately; even importing a changed config is not exempted.
+fn verified_base_import(root: &Path, reader: &mut CommitReader) -> Result<Option<String>> {
+    if !git::has_commit(root, "HEAD")? {
+        return Ok(None);
+    }
+    let head = git::head(root)?;
+    let Ok(text) = reader.text(&head, CONFIG) else {
+        return Ok(None);
+    };
+    let Ok(config) = parse_config(Path::new(CONFIG), &text) else {
+        return Ok(None);
+    };
+    if git::current_branch(root)?.as_deref() == Some(config.base_branch.as_str())
+        || reader.staged(CONFIG).ok().as_deref() != Some(text.as_bytes())
+    {
+        return Ok(None);
+    }
+    // --git-path also finds a linked worktree's own merge state.
+    let path = git::run(
+        root,
+        &[
+            "rev-parse",
+            "--path-format=absolute",
+            "--git-path",
+            "MERGE_HEAD",
+        ],
+    )?;
+    let incoming = match std::fs::read_to_string(path) {
+        Ok(text) => text,
+        Err(error) if error.kind() == ErrorKind::NotFound => return Ok(None),
+        Err(error) => return Err(error.into()),
+    };
+    let parents: Vec<_> = incoming.lines().collect();
+    let [parent] = parents.as_slice() else {
+        return Ok(None);
+    };
+    // A MERGE_HEAD is an object ID, never an arbitrary rev expression.
+    if parent.len() != head.len() || !parent.bytes().all(|b| b.is_ascii_hexdigit()) {
+        return Ok(None);
+    }
+    let mut refs = vec![format!("refs/heads/{}", config.base_branch)];
+    if let Some(forge) = config.forge {
+        refs.push(format!(
+            "refs/remotes/{}/{}",
+            forge.remote, config.base_branch
+        ));
+    }
+    for reference in refs {
+        if git::run(
+            root,
+            &["rev-parse", "--verify", &format!("{reference}^{{commit}}")],
+        )
+        .ok()
+        .as_deref()
+            == Some(*parent)
+        {
+            return Ok(Some((*parent).to_owned()));
+        }
+    }
+    Ok(None)
+}
