/target/
# The release workflow writes it before building, which would mark the
# version dirty (crates/atelier-cli/build.rs).
/dist-manifest.json
.env

# Atelier project state under .atelier/ is tracked intentionally.
# Keep canonical records and .atelier/config.toml visible to git; ignore only
# local runtime, identity, lock, and generated integration artifacts.
/.atelier/.locks-cache/
/.atelier/agent.json
/.atelier/hook-config.json
/.atelier/hook-config.local.json
/.atelier/runtime/
/.atelier-bundle-stage-*/
